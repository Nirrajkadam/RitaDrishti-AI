# RitaDrishti-AI Environment Configuration Template
# Copy this file to .env before starting services with docker-compose

APP_ENV=development
JWT_SECRET=ritadrishti_dev_secret_key_change_in_production_2026_9f8a
POSTGRES_PASSWORD=ritadrishti_secret
DATABASE_URL=sqlite+aiosqlite:///./ritadrishti.db

# Optional Subsystems (Disabled by Default)
ENABLE_OLLAMA=false
ENABLE_QDRANT=false
ENABLE_CREWAI=false
ENABLE_NPU=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
QDRANT_HOST=localhost
QDRANT_PORT=6333
