# RitaDrishti-AI Environment Configuration Template
# Copy this file to .env for local development with Docker Compose:
# cp .env.example .env

APP_ENV=development
JWT_SECRET=ritadrishti_dev_secret_key_2026_9f8a
POSTGRES_PASSWORD=ritadrishti_secret
DATABASE_URL=sqlite+aiosqlite:///./ritadrishti.db

# Production Environment Instructions:
# For production deployments, generate a secure random 32-byte secret:
# openssl rand -hex 32
# And run with compose.production.yaml:
# APP_ENV=production JWT_SECRET="..." POSTGRES_PASSWORD="..." docker compose -f compose.yaml -f compose.production.yaml up -d --build --wait

# Optional Subsystems (Disabled by Default)
ENABLE_OLLAMA=false
ENABLE_QDRANT=false
ENABLE_CREWAI=false
ENABLE_NPU=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
QDRANT_HOST=localhost
QDRANT_PORT=6333
