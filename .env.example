# SentinelX Trust AI Environment Configuration

APP_NAME="SentinelX Trust AI"
APP_ENV="development"
DEBUG=True

# Database Configuration
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx_secret
POSTGRES_DB=sentinelx_trust_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinelx:sentinelx_secret@localhost:5432/sentinelx_trust_db

# Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Qualcomm Snapdragon Optimization
USE_SNAPDRAGON_NPU=False
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider  # Change to DmlExecutionProvider or QNNExecutionProvider on Windows Copilot+ PCs

# Security Secret Key
JWT_SECRET=super_secret_jwt_key_sentinelx_2026
JWT_ALGORITHM=HS256
